{
  "name": "N3X Network",
  "schemaVersion": 3,
  "mode": "github-pages-admin-managed",
  "transport": "https",
  "pagesBase": "https://iooimc.github.io/N3X-Launcher/",
  "rawBase": "https://raw.githubusercontent.com/iooimc/N3X-Launcher/main/",
  "capeServiceUrl": "https://iooimc.github.io/N3X-Launcher/network",
  "protocol": "n3x-capes-v1",
  "endpoints": {
    "protocolManifest": "network/v1/manifest.json",
    "launcherClient": "network/client.cjs",
    "capeCatalog": "network/capes/catalog.json",
    "userIndex": "network/users/index.json",
    "userDirectory": "network/users/",
    "assignedCapeDirectory": "network/v1/capes/",
    "publicPage": "index.html",
    "registrationPage": "register.html",
    "adminPage": "admin.html"
  },
  "capabilities": {
    "publicCapeCatalog": true,
    "publicProfiles": true,
    "publicAssignedCapeRead": true,
    "clientReadWithoutToken": true,
    "uuidBasedCapeLookup": true,
    "sharedLauncherClient": true,
    "playerRegistrationViaGithubIssue": true,
    "adminAssignmentViaGithubContentsApi": true,
    "ownerLauncherPublisher": true
  },
  "security": {
    "embedGithubWriteTokenInClient": false,
    "adminTokenPersistence": false,
    "ownerLauncherTokenStorage": "local-electron-safeStorage",
    "ownerLauncherTokenScope": "fine-grained token restricted to N3X-Launcher with Contents read/write",
    "minecraftAccessTokenSentToGithub": false,
    "notes": "Public launchers and mods only need read access. Optional owner publishing stores a repository-scoped GitHub token locally using Electron safeStorage; no write token is committed to the repository or bundled into the launcher."
  }
}
