{
  "name": "N3X Network",
  "schemaVersion": 4,
  "mode": "static-site-plus-live-cape-service",
  "transport": "https",
  "pagesBase": "https://iooimc.github.io/N3X-Launcher/",
  "rawBase": "https://raw.githubusercontent.com/iooimc/N3X-Launcher/main/",
  "capeServiceUrl": "https://n3x.asterwyn.net/capes",
  "protocol": "n3x-capes-v1",
  "endpoints": {
    "protocolManifest": "network/v1/manifest.json",
    "launcherClient": "network/client.cjs",
    "capeCatalog": "network/capes/catalog.json",
    "userIndex": "network/users/index.json",
    "userDirectory": "network/users/",
    "legacyAssignedCapeDirectory": "network/v1/capes/",
    "liveCapeService": "https://n3x.asterwyn.net/capes",
    "liveCapeTexture": "https://n3x.asterwyn.net/capes/v1/capes/{uuid}.png",
    "liveProfile": "https://n3x.asterwyn.net/capes/v1/profiles/{uuid}.json",
    "publicPage": "index.html",
    "registrationPage": "register.html",
    "adminPage": "admin.html"
  },
  "capabilities": {
    "publicCapeCatalog": true,
    "publicProfiles": true,
    "publicAssignedCapeRead": true,
    "clientReadWithoutToken": true,
    "uuidBasedCapeLookup": true,
    "inGameCapeSelection": true,
    "launcherAutoPublish": true,
    "minecraftIdentityVerifiedCapeWrite": true,
    "githubTokenRequiredForPlayers": false
  },
  "security": {
    "embedGithubWriteTokenInClient": false,
    "playerGithubTokenRequired": false,
    "writeAuthentication": "Minecraft access token verified against Minecraft Services profile ownership",
    "minecraftAccessTokenPersistenceOnCapeService": false,
    "notes": "Players do not need a GitHub token or a separate N3X account. The launcher uses its existing Minecraft session only when publishing or deleting that player's own UUID cape. Public cape reads require no authentication."
  }
}
