{
  "schemaVersion": 2,
  "protocol": "n3x-capes-v1",
  "network": "N3X Network",
  "pagesBase": "https://iooimc.github.io/N3X-Launcher/",
  "capeServiceUrl": "https://n3x.asterwyn.net/capes",
  "uuidFormat": "minecraft-uuid-dashed-lowercase",
  "cacheSeconds": 30,
  "endpoints": {
    "config": "https://iooimc.github.io/N3X-Launcher/network/config.json",
    "catalog": "https://iooimc.github.io/N3X-Launcher/network/capes/catalog.json",
    "capeTexture": "https://n3x.asterwyn.net/capes/v1/capes/{uuid}.png",
    "profile": "https://n3x.asterwyn.net/capes/v1/profiles/{uuid}.json",
    "health": "https://n3x.asterwyn.net/capes/healthz"
  },
  "clientRules": {
    "readWithoutAuthentication": true,
    "writeFromLauncher": true,
    "writeFromMod": false,
    "writeUsesMinecraftIdentity": true,
    "githubTokenRequired": false,
    "resolveByUuid": true,
    "usernameIsDisplayOnly": true,
    "missingCapeMeansNoNetworkCape": true
  }
}
